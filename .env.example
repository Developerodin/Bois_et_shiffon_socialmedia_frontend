SERVER_URL=http://localhost:3101
# The website's public origin; sent as Origin on server-side writes (must be in the server's AUTH_URL or WEB_ORIGINS).
WEB_ORIGIN=http://localhost:3100
# Features on for everyone: comma list of library, photoshoot, reels, stories, inbox, automations, onboarding, plans.
WEB_FEATURES=
# Features opened to single workspaces: comma list of feature:workspaceId pairs, e.g. inbox:abc123.
WEB_FEATURE_WORKSPACES=
# The origin signed media links point at, e.g. https://<bucket host>; allowed for media and uploads in the CSP.
STORAGE_ORIGIN=
