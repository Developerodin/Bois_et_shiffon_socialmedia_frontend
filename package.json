    "@radix-ui/react-slot": "^1.5.0",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "react": "~19.1.2",
